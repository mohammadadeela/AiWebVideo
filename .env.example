# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ---- Public app URL (used for CORS, sitemap, links) ----
NEXT_PUBLIC_APP_URL=https://your-domain.com
ALLOWED_ORIGIN=https://your-domain.com

# ---- Database ----
DATABASE_URL=postgres://aiwebvideo_user:PASSWORD@127.0.0.1:5432/aiwebvideo

# ---- Sessions / local JWT auth ----
# Required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---- Admin bootstrap (optional) ----
# Whoever signs in/registers with this email is auto-promoted to admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ================================================================
# FIREBASE — Google & GitHub sign-in
# ================================================================
# 1) Go to https://console.firebase.google.com -> your project (or create one).
# 2) Authentication -> Sign-in method -> enable "Google" and "GitHub".
#    - Google: just toggle it on, pick a support email.
#    - GitHub: create an OAuth App at https://github.com/settings/developers,
#      set its "Authorization callback URL" to the value Firebase shows you
#      (looks like https://YOUR_PROJECT.firebaseapp.com/__/auth/handler),
#      then paste GitHub's Client ID + Client Secret into Firebase.
# 3) Authentication -> Settings -> Authorized domains -> add your real
#    domain (e.g. your-domain.com) AND localhost for local dev. Popups fail
#    silently (or with auth/unauthorized-domain) if this step is skipped.
# 4) Project settings -> General -> "Your apps" -> add a Web app -> copy the
#    config values below (this is the PUBLIC, browser-side config; it's fine
#    for it to ship to the client).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 5) Project settings -> Service accounts -> Generate new private key. This
#    downloads a JSON file the SERVER uses to verify Firebase ID tokens.
#    Either paste the whole JSON into FIREBASE_ADMIN_CREDENTIAL_JSON, or
#    split it into the three fields below (from that same JSON file).
FIREBASE_ADMIN_CREDENTIAL_JSON=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ================================================================
# EMAIL — sends the 6-digit sign-up verification code
# ================================================================
# Gmail account + App Password (same setup used across our other projects):
#   1. Turn on 2-Step Verification on the Google account.
#   2. Create an "App password" at https://myaccount.google.com/apppasswords
#   3. Fill in EMAIL_USER (the Gmail address) and EMAIL_PASS (the 16-char
#      app password, no spaces) below.
#
# If these are left blank, the server does NOT fail — it logs the
# verification code to the server console instead, so local development
# keeps working without a real mailbox. Do this ONLY in development.
EMAIL_USER=
EMAIL_PASS=

# ---- AI generation ----
GEMINI_API_KEY=
GEMINI_STORYBOARD_MODEL=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Optional accounting overrides if Google changes image output pricing.
GEMINI_IMAGE_COST_2K_USD=0.101
GEMINI_IMAGE_COST_4K_USD=0.151
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
# Optional royalty-cleared instrumental file for the Music only option.
# When omitted, the server creates a voice-free ambient instrumental bed.
BACKGROUND_MUSIC_PATH=
# Optional accounting overrides for Gemini text planning/script tokens.
GEMINI_TEXT_INPUT_COST_PER_MILLION_USD=0.50
GEMINI_TEXT_OUTPUT_COST_PER_MILLION_USD=3.00

# ---- Storage ----
ASSETS_DIR=/var/lib/aiwebvideo/assets

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SINGLE_8=
STRIPE_PRICE_SINGLE_30=
STRIPE_PRICE_SINGLE_60=
STRIPE_PRICE_TOPUP_100_CREDITS=

# ---- PayPal (optional) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# ---- Performance tuning (optional, sane defaults exist in code) ----
CAPTURE_CONCURRENCY=1
AI_VIDEO_CONCURRENCY=2
